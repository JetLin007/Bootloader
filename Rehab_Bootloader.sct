; *************************************************************
; *** Scatter-Loading Description File generated by STM32CubeMX ***
; *** Modified for Bootloader: Flash = 64KB ***
; *************************************************************

LR_IROM1 0x08000000 0x00010000  {    ; 加载区域：Flash起始0x08000000，大小64KB
  ER_IROM1 0x08000000 0x00010000  {  ; 执行区域：同加载地址
   *.o (RESET, +First)               ; 中断向量表放在最前面
   *(InRoot$$Sections)
   .ANY (+RO)                        ; 所有只读代码和数据
   .ANY (+XO)
  }
  RW_IRAM1 0x20000000 0x00040000  {  ; RAM：起始0x20000000，大小256KB
   .ANY (+RW +ZI)                    ; 可读写数据和零初始化数据
  }
}
